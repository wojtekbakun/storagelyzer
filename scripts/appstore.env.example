# Copy to scripts/appstore.env (ignored by git) and fill in once the Apple
# Developer Program membership is active. Step-by-step: appstore/README.md.

# developer.apple.com → Account → Membership details → Team ID (10 characters)
APPLE_TEAM_ID=ABCDE12345

# Exact names as listed by:  security find-identity -v
APP_SIGN_IDENTITY="Apple Distribution: First Last (ABCDE12345)"
INSTALLER_SIGN_IDENTITY="3rd Party Mac Developer Installer: First Last (ABCDE12345)"

# Mac App Store provisioning profile for com.wojtek.storagelyzer
PROVISIONING_PROFILE="$HOME/Downloads/Storagelyzer_Mac_App_Store.provisionprofile"

# Optional: App Store Connect API key for `scripts/appstore.sh upload`
# (Users and Access → Integrations → App Store Connect API, role "Developer").
# Put the downloaded AuthKey_<KEY_ID>.p8 into ~/.appstoreconnect/private_keys/
ASC_KEY_ID=
ASC_ISSUER_ID=

# Optional: build number (CFBundleVersion); defaults to the date and time, e.g. 20261119.1630
# BUILD_NUMBER=
